{
  "name": "leonid-fit",
  "version": "1.0.0",
  "private": true,
  "description": "LEONID fitness club static website",
  "scripts": {
    "check:html": "html-validate index.html",
    "check:css": "stylelint style.css",
    "check:assets": "python3 scripts/check_assets.py",
    "check": "pnpm run check:html && pnpm run check:css && pnpm run check:js && pnpm run check:assets",
    "build": "python3 scripts/build_site.py",
    "check:js": "node --check script.js"
  },
  "devDependencies": {
    "html-validate": "11.17.0",
    "stylelint": "17.16.0"
  },
  "packageManager": "pnpm@11.25.0"
}
